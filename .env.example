# Copy to .env — docker compose reads this file.
# Never commit the real .env.

# --- Postgres ---
POSTGRES_DB=store_rating_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Backend ---
NODE_ENV=development
PORT=3000
# Host name is the compose service name, not localhost.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/store_rating_db?schema=public
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3000/api
