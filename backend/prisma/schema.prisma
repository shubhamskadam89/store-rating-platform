generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  NORMAL_USER
  SYSTEM_ADMIN
  STORE_OWNER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  address   String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
