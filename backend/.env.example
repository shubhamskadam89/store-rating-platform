NODE_ENV=development
PORT=3000
# Running the API on the host (npm run start:dev) -> localhost.
# Running inside docker compose -> replace localhost with "postgres".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/store_rating_db?schema=public
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
